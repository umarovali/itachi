# Скопируйте этот файл в .env и заполните. Файл .env никому не показывайте.

# --- Сервер ---
PORT=3000
# Адрес сайта для людей (нужен для ссылок в боте). Локально:
PUBLIC_SITE_URL=http://localhost:5173

# --- Donix ---
# Пока DONIX_API_KEY пустой — сервер работает в ТЕСТОВОМ режиме (заказы не уходят в Donix).
DONIX_API_KEY=
# Базовый адрес API — сверьте с документацией в кабинете Donix.
DONIX_BASE_URL=https://donix.org/api/partner/v1
# Секрет вебхука из «Настроек API» в кабинете Donix.
DONIX_WEBHOOK_SECRET=

# --- Telegram-бот ---
# Токен от @BotFather. Пока пустой — бот выключен.
TELEGRAM_BOT_TOKEN=
# Админы хранятся в базе. Суперадмин (всегда один) назначается кодом /claim,
# который сервер покажет в консоли при первом запуске.

# --- Цены ---
# Наценка в процентах поверх цены Donix (можно менять в боте: /markup 12).
MARKUP_PERCENT=10
# Сколько минут даётся на оплату заказа.
ORDER_TTL_MINUTES=30
